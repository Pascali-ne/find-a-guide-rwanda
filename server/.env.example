# Copy this file to ".env" (the project already ships with a working ".env" for local development).
PORT=4000
JWT_SECRET=change-this-to-a-long-random-string
CLIENT_ORIGIN=http://localhost:5173
DB_PATH=./data/findaguide.db
UPLOAD_DIR=./uploads
# Automatically seed demo data when the database is empty (true/false)
AUTO_SEED=true
